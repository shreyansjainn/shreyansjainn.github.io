---
// Feature-geometry mark: 5 unit vectors from an origin to pentagon vertices.
// The site's signature glyph (from the toy-models superposition work).
const { size = 22 } = Astro.props;
// vertices on a circle r=8 about (12,12), first at top
const verts = [
  [12, 4],
  [19.61, 9.53],
  [16.7, 18.47],
  [7.3, 18.47],
  [4.39, 9.53],
];
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  aria-hidden="true"
  class="pentmark"
>
  {verts.map(([x, y]) => <line x1="12" y1="12" x2={x} y2={y} />)}
  {verts.map(([x, y]) => <circle cx={x} cy={y} r="1.35" fill="currentColor" stroke="none" />)}
  <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" opacity="0.5" />
</svg>
<style>
  .pentmark {
    color: var(--accent);
    flex: none;
  }
</style>
