---
import { site, nav } from '../data/site';
import PentagonMark from './PentagonMark.astro';
---
<header class="nav">
  <div class="wrap wrap-wide nav-inner">
    <a href="/" class="brand">
      <PentagonMark size={20} />
      <span>shreyans_jain</span>
    </a>
    <nav class="links" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href}>
            <span class="slash">~/</span>{item.label.replace(/\s+/g, '-')}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
  }
  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .links a {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .links a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .links a:hover .slash {
    color: var(--accent);
  }
  .slash {
    color: var(--faint);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .dark-only {
    display: none;
  }
  .light-only {
    display: inline-flex;
  }
  :global(:root[data-theme='dark']) .light-only {
    display: none;
  }
  :global(:root[data-theme='dark']) .dark-only {
    display: inline-flex;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .light-only {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .dark-only {
      display: inline-flex;
    }
  }
  @media (max-width: 620px) {
    .nav-inner {
      height: auto;
      padding-block: 0.55rem;
      flex-wrap: wrap;
    }
    .links {
      order: 3;
      width: 100%;
      margin-left: 0;
      gap: 0.8rem;
    }
  }
</style>
