---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
---
<header class="nav">
  <div class="wrap wrap-wide nav-inner">
    <a href="/" class="brand">{site.name}</a>
    <nav class="links" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle colour theme">
      <span class="light-only"><Icon name="moon" size={17} /></span>
      <span class="dark-only"><Icon name="sun" size={17} /></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.6rem;
  }
  .brand {
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
    font-size: 0.98rem;
  }
  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.15rem;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .links a {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .links a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  :global(:root[data-theme='dark']) .light-only,
  :global(:root:not([data-theme='light'])) .light-only {
    display: none;
  }
  :global(:root[data-theme='dark']) .dark-only,
  :global(:root:not([data-theme='light'])) .dark-only {
    display: inline-flex;
  }
  .dark-only {
    display: none;
  }
  .light-only {
    display: inline-flex;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .light-only {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .dark-only {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .nav-inner {
      height: auto;
      padding-block: 0.6rem;
      flex-wrap: wrap;
    }
    .links {
      order: 3;
      width: 100%;
      margin-left: 0;
      gap: 0.9rem;
    }
  }
</style>
