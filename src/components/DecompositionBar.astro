---
// A named behaviour rendered as a weighted bar of atomic traits.
// Hover/focus a segment to highlight it and its label.
import { decomposition } from '../data/research';
const { behaviour, parts, source } = decomposition;
---
<figure class="decompfig">
  <div class="expr">
    <span class="lhs">{behaviour}</span>
    <span class="eq">=</span>
    <span class="rhs muted">Σ atomic traits</span>
  </div>
  <div class="bar" role="img" aria-label={`${behaviour} decomposed into ${parts.map((p) => p.name).join(', ')}`}>
    {
      parts.map((p, i) => (
        <span class="seg" style={`flex:${p.weight}`} data-i={i} tabindex="0">
          <span class="seg-tip">{p.name} · {p.weight}%</span>
        </span>
      ))
    }
  </div>
  <ul class="legend">
    {
      parts.map((p, i) => (
        <li data-i={i}>
          <span class="sw" /> {p.name}
        </li>
      ))
    }
  </ul>
  <figcaption>
    schematic (illustrative weights) · from
    <a href={source.href} target="_blank" rel="noopener">{source.label} ↗</a>
  </figcaption>
</figure>

<style>
  .decompfig {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    background: var(--surface);
  }
  .expr {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .expr .lhs {
    color: var(--accent);
    font-weight: 600;
  }
  .expr .eq {
    color: var(--faint);
  }
  .bar {
    display: flex;
    gap: 3px;
    height: 26px;
    margin-bottom: 0.75rem;
  }
  .seg {
    position: relative;
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    border-radius: 1px;
    cursor: default;
    transition: background 0.15s, transform 0.15s;
  }
  .seg:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }
  .seg:hover,
  .seg:focus-visible {
    background: var(--accent);
    outline: none;
  }
  .seg-tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.72rem;
    background: var(--text);
    color: var(--bg);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
  }
  .seg:hover .seg-tip,
  .seg:focus-visible .seg-tip {
    opacity: 1;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .legend .sw {
    width: 9px;
    height: 9px;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
  }
  .legend li[data-i="0"] .sw {
    background: var(--accent);
    border-color: var(--accent);
  }
  figcaption {
    margin-top: 0.7rem;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--faint);
    line-height: 1.5;
  }
  figcaption a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  figcaption a:hover {
    color: var(--accent);
  }
</style>
