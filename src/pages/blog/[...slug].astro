---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} ogType="article">
  <article class="wrap post" style="padding-block: 3rem;">
    <a href="/blog" class="back">← all posts</a>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    {
      post.data.external && (
        <p class="crosspost">
          <Icon name="external" size={14} /> Originally posted on{' '}
          <a href={post.data.external} target="_blank" rel="noopener">the original source</a>.
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: 720px;
  }
  .back {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .post h1 {
    font-size: 2rem;
    margin: 1rem 0 0.6rem;
    line-height: 1.15;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--faint);
    margin-bottom: 1.4rem;
  }
  .tag {
    background: var(--accent-soft);
    color: var(--muted);
    padding: 0.1rem 0.5rem;
    border-radius: 20px;
  }
  .crosspost {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--muted);
    background: var(--accent-soft);
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    margin-bottom: 1.6rem;
  }
</style>
