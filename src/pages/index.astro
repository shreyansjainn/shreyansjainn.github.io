---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PublicationList from '../components/PublicationList.astro';
import DecompositionBar from '../components/DecompositionBar.astro';
import CareerTrajectory from '../components/CareerTrajectory.astro';
import { site, socials } from '../data/site';
import { publications } from '../data/publications';
import { directions, software, additionalInterests } from '../data/research';
import { summary, researchExperience, industryExperience, education } from '../data/cv';
import { repeatReads } from '../data/reads';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

const SecHead = 'div';
---
<Base>
  <!-- ABOUT / HERO -->
  <section id="about" class="section hero">
    <div class="wrap wrap-wide hero-grid">
      <div class="hero-text">
        <div class="handle">
          <span class="hl">shreyans_jain</span>
          <span class="hl faint">· @py_parrot · independent researcher</span>
        </div>
        <p class="eyebrow">mechanistic interpretability
          <span class="kw">· training dynamics</span>
          <span class="kw">· behavioural decomposition</span>
        </p>
        <h1>Shreyans Jain<span class="cursor">▍</span></h1>
        <p class="lead">
          i'm shreyans. i studied civil engineering in undergrad, and learned ML
          and programming afterwards alongside my job solely due to my interest in
          maths and problem solving.
        </p>
        <p class="sub">
          my aim is to work full time on ML interpretability research because
          personally, i would like to understand more about whats going under the
          hood of a complex AI system responsible for deciding whether its a dog or
          a cat or what word i should be typing next. in addition, my interest lies
          in reinforcement learning, ai ethics as well so i try to keep myself up to
          date on these topics too.
        </p>
        <p class="sub">
          two threads pull at me the most right now — <strong>training dynamics</strong>
          and <strong>behavioural decomposition</strong>. training dynamics because i
          think <em>when</em> a behaviour or capability forms during training often
          explains more than staring at the final model ever could. and behavioural
          decomposition because messy, named behaviours like sycophancy feel like
          they're built out of smaller, measurable traits — and if that's true, we can
          actually measure and steer them instead of just describing them.
        </p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="/#publications">publications <Icon name="arrow" size={14} /></a>
          <a class="btn" href={site.cvPdf} target="_blank" rel="noopener">cv.pdf</a>
          <a class="btn" href={`mailto:${site.email}`}>get in touch</a>
        </div>
        <div class="hero-socials">
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <Icon name={s.icon} size={18} />
              </a>
            ))
          }
        </div>
      </div>
      <div class="hero-viz">
        <img class="hero-photo" src="/assets/img/profile_pic.jpg" alt="Shreyans Jain" width="240" height="240" />
      </div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section id="research" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§01</span><span class="dot">·</span><span class="name">research</span><span class="rule"></span></SecHead>
      <p class="section-lead">Two directions carry most of my current work.</p>
      <div class="dirs">
        {
          directions.map((d, i) => (
            <article class="dir">
              <div class="dir-k">0{i + 1}</div>
              <div>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="research-grid">
        <div>
          <h3 class="subhead">Decomposition, concretely</h3>
          <DecompositionBar />
        </div>
        <div>
          <h3 class="subhead">Additional research interests</h3>
          <ul class="chips">
            {additionalInterests.map((i) => <li><span class="br">[</span>{i}<span class="br">]</span></li>)}
          </ul>
        </div>
      </div>

      <h3 class="subhead">Career trajectory</h3>
      <CareerTrajectory />
    </div>
  </section>

  <!-- NOW -->
  <section id="now" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§02</span><span class="dot">·</span><span class="name">now</span><span class="rule"></span></SecHead>
      <p class="section-lead">
        I'm a Research Fellow at LASR Labs, mentored by Satvik Golecha, working
        with the UK AI Security Institute's Model Transparency team on model
        organisms and the training dynamics of emergent misalignment. Alongside,
        I'm exploring behaviour compositions and multilingual interpretability.
      </p>
      <p class="section-lead">
        I'm open to full-time, part-time, or collaboration opportunities in
        interpretability research. Reach me at
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>

  <!-- PUBLICATIONS -->
  <section id="publications" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§03</span><span class="dot">·</span><span class="name">publications</span><span class="rule"></span></SecHead>
      <p class="section-lead">Reverse-chronological. <span class="muted">* denotes equal contribution.</span></p>
      <PublicationList items={publications} />
    </div>
  </section>

  <!-- CV -->
  <section id="cv" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§04</span><span class="dot">·</span><span class="name">cv</span><span class="rule"></span></SecHead>
      <p class="section-lead">{summary}</p>

      <h3 class="subhead">Research experience <span class="traj-note">— most recent first</span></h3>
      <ul class="traj">
        {
          researchExperience.map((r) => (
            <li>
              <span class="node" aria-hidden="true"></span>
              <div class="traj-period muted mono-num">{r.period}</div>
              <div class="traj-body">
                <div class="traj-head"><strong>{r.title}</strong>, {r.org}</div>
                {r.detail && <div class="traj-detail muted">{r.detail}</div>}
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="subhead">Prior industry experience</h3>
      <p class="section-lead muted" style="margin-bottom: 0.9rem;">8 years building production ML systems before interpretability. Full detail in the CV.</p>
      <ul class="rows">
        {
          industryExperience.map((r) => (
            <li>
              <span class="r-period muted mono-num">{r.period}</span>
              <span class="r-body"><strong>{r.title}</strong>, {r.org}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="subhead">Education</h3>
      <ul class="rows">
        {
          education.map((e) => (
            <li>
              <span class="r-period muted mono-num">{e.period}</span>
              <span class="r-body"><strong>{e.title}</strong>, {e.org}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero-actions" style="margin-top: 1.6rem;">
        <a class="btn btn-accent" href={site.cvPdf} target="_blank" rel="noopener">full cv.pdf <Icon name="external" size={13} /></a>
      </div>
    </div>
  </section>

  <!-- OPEN SOURCE -->
  <section id="software" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§05</span><span class="dot">·</span><span class="name">open-source</span><span class="rule"></span></SecHead>
      <p class="section-lead">Research tools I've built and released.</p>
      <div class="dirs">
        {
          software.map((s) => (
            <a class="dir dir-link" href={s.href} target="_blank" rel="noopener">
              <div class="dir-k">›</div>
              <div>
                <h3>{s.name}<Icon name="external" size={13} /></h3>
                <p>{s.body}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WRITING -->
  <section id="writing" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§06</span><span class="dot">·</span><span class="name">writing</span><span class="rule"></span></SecHead>
      <p class="section-lead">Research notes and the occasional essay. <a href="/blog">all posts →</a></p>
      <ul class="post-list">
        {
          posts.map((p) => (
            <li>
              <a class="post-link" href={`/blog/${p.id}`}>
                <span class="post-date mono-num">[{fmt(p.data.date)}]</span>
                <span class="post-title">{p.data.title}</span>
              </a>
              {p.data.description && <p class="post-desc muted">{p.data.description}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- OUTSIDE WORK -->
  <section id="outside" class="section">
    <div class="wrap wrap-wide">
      <SecHead class="sec-head"><span class="num">§07</span><span class="dot">·</span><span class="name">outside work</span><span class="rule"></span></SecHead>
      <p class="section-lead">
        when i'm not working i'm probably thinking about how i can improve my
        strength &amp; form in pull-ups and dreaming about muscle ups 🏋️, or learning
        about the Xs and Os of basketball. i occasionally pick up a book (mainly
        it's on my kindle :P) too, trying to learn more about indian history, world
        history — but won't shy away from a good fiction (sci-fi preferred) or some
        new topic that looks interesting to me.
      </p>

      <h3 class="subhead">Repeat reads</h3>
      <ul class="reads">
        {
          repeatReads.map((r) => (
            <li>
              <span class="br">&gt;</span>
              <a href={r.href} target="_blank" rel="noopener">{r.title}<Icon name="external" size={12} /></a>
              <span class="muted"> — {r.author}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    padding-top: 2.8rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: 2.6rem;
    align-items: center;
  }
  .handle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 1.1rem;
    font-size: 0.82rem;
  }
  .hl {
    font-weight: 600;
  }
  .hl.faint {
    font-weight: 400;
    color: var(--faint);
  }
  .eyebrow {
    line-height: 1.5;
  }
  .eyebrow .kw {
    color: var(--faint);
  }
  .hero h1 {
    font-size: 2.3rem;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .cursor {
    color: var(--accent);
    font-weight: 400;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .lead {
    font-size: 1rem;
    margin: 0 0 0.9rem;
  }
  .sub {
    color: var(--muted);
    margin: 0 0 0.9rem;
    font-size: 0.92rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.3rem 0;
  }
  .hero-socials {
    display: flex;
    gap: 1rem;
  }
  .hero-socials a {
    color: var(--muted);
    display: inline-flex;
  }
  .hero-socials a:hover {
    color: var(--accent);
  }
  .hero-viz {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.3rem;
    max-width: 280px;
    margin-inline: auto;
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--border);
    filter: grayscale(0.08);
  }

  /* ---- research directions ---- */
  .dirs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .dir {
    display: flex;
    gap: 0.9rem;
    padding: 1.15rem 1.25rem;
    background: var(--bg);
  }
  .dir-k {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    padding-top: 0.15rem;
  }
  .dir h3 {
    margin: 0 0 0.45rem;
    font-size: 0.98rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .dir p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .dir-link {
    color: var(--text);
    transition: background 0.15s;
  }
  .dir-link:hover {
    text-decoration: none;
    background: var(--accent-soft);
  }
  .dir-link:hover h3 {
    color: var(--accent);
  }

  .research-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.8rem;
    margin-top: 0.5rem;
  }

  /* ---- chips ---- */
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips li {
    font-size: 0.8rem;
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
  }
  .chips .br {
    color: var(--accent);
  }

  /* ---- trajectory timeline ---- */
  .traj-note {
    text-transform: none;
    letter-spacing: 0;
    color: var(--faint);
    font-weight: 400;
  }
  .traj {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .traj::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--border);
  }
  .traj li {
    position: relative;
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0 0 1.15rem 1.6rem;
  }
  .traj .node {
    position: absolute;
    left: 0;
    top: 6px;
    width: 9px;
    height: 9px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--bg);
  }
  .traj-period {
    font-size: 0.82rem;
    padding-top: 0.05rem;
  }
  .traj-detail {
    font-size: 0.84rem;
  }

  /* ---- plain rows (industry, education) ---- */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .rows li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .r-period {
    font-size: 0.82rem;
  }

  /* ---- writing ---- */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }
  .post-link {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    color: var(--text);
  }
  .post-link:hover {
    text-decoration: none;
  }
  .post-link:hover .post-title {
    color: var(--accent);
  }
  .post-date {
    color: var(--accent);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .post-title {
    font-weight: 500;
  }
  .post-desc {
    margin: 0.3rem 0 0 4.4rem;
    font-size: 0.85rem;
  }

  /* ---- reads ---- */
  .reads {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .reads li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .reads .br {
    color: var(--accent);
  }
  .reads a {
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .hero-viz {
      order: -1;
      max-width: 260px;
    }
    .dirs,
    .research-grid {
      grid-template-columns: 1fr;
    }
    .traj li,
    .rows li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .post-desc {
      margin-left: 0;
    }
  }
</style>
