---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PublicationList from '../components/PublicationList.astro';
import { site, socials } from '../data/site';
import { publications } from '../data/publications';
import { directions, software } from '../data/research';
import { summary, researchExperience, industryExperience, education } from '../data/cv';
import { repeatReads } from '../data/reads';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---
<Base>
  <!-- ABOUT / HERO -->
  <section id="about" class="section hero">
    <div class="wrap wrap-wide hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{site.tagline}</p>
        <h1>Shreyans Jain</h1>
        <p class="lead">
          i'm shreyans. i studied civil engineering in undergrad, and learned ML
          and programming afterwards alongside my job solely due to my interest in
          maths and problem solving.
        </p>
        <p class="sub">
          my aim is to work full time on ML interpretability research because
          personally, i would like to understand more about whats going under the
          hood of a complex AI system responsible for deciding whether its a dog or
          a cat or what word i should be typing next. in addition, my interest lies
          in reinforcement learning, ai ethics as well so i try to keep myself up to
          date on these topics too.
        </p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="/#publications">Publications <Icon name="arrow" size={15} /></a>
          <a class="btn" href={site.cvPdf} target="_blank" rel="noopener">CV (PDF)</a>
          <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
        </div>
        <div class="hero-socials">
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <Icon name={s.icon} size={19} />
              </a>
            ))
          }
        </div>
      </div>
      <div class="hero-photo">
        <img src="/assets/img/profile_pic.jpg" alt="Shreyans Jain" width="220" height="220" />
      </div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section id="research" class="section">
    <div class="wrap wrap-wide">
      <h2>Research</h2>
      <p class="section-lead">Two directions carry most of my current work.</p>
      <div class="cards">
        {
          directions.map((d, i) => (
            <article class={`card card-${i % 2 === 0 ? 'a' : 'b'}`}>
              <h3>{d.title}</h3>
              <p>{d.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NOW -->
  <section id="now" class="section tint">
    <div class="wrap wrap-wide">
      <h2>Now</h2>
      <p class="section-lead">
        I'm a Research Fellow at LASR Labs, working with the UK AI Security
        Institute's Model Transparency team on model organisms and the training
        dynamics of emergent misalignment. Alongside, I'm exploring behaviour
        compositions and multilingual interpretability.
      </p>
      <p class="section-lead">
        I'm open to full-time, part-time, or collaboration opportunities in
        interpretability research. Reach me at
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>

  <!-- PUBLICATIONS -->
  <section id="publications" class="section">
    <div class="wrap wrap-wide">
      <h2>Publications</h2>
      <p class="section-lead">Reverse-chronological. <span class="muted">* denotes equal contribution.</span></p>
      <PublicationList items={publications} />
    </div>
  </section>

  <!-- CV -->
  <section id="cv" class="section">
    <div class="wrap wrap-wide">
      <h2>CV</h2>
      <p class="section-lead">{summary}</p>

      <h3 class="subhead">Research experience</h3>
      <ul class="timeline">
        {
          researchExperience.map((r) => (
            <li>
              <div class="tl-period muted">{r.period}</div>
              <div class="tl-body">
                <div class="tl-head"><strong>{r.title}</strong>, {r.org}</div>
                {r.detail && <div class="tl-detail muted">{r.detail}</div>}
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="subhead">Prior industry experience</h3>
      <p class="section-lead muted" style="margin-bottom: 1rem;">
        8 years building production ML systems before interpretability. Full detail in the CV.
      </p>
      <ul class="timeline compact">
        {
          industryExperience.map((r) => (
            <li>
              <div class="tl-period muted">{r.period}</div>
              <div class="tl-body">
                <div class="tl-head"><strong>{r.title}</strong>, {r.org}</div>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="subhead">Education</h3>
      <ul class="timeline">
        {
          education.map((e) => (
            <li>
              <div class="tl-period muted">{e.period}</div>
              <div class="tl-body">
                <div class="tl-head"><strong>{e.title}</strong>, {e.org}</div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="hero-actions">
        <a class="btn btn-accent" href={site.cvPdf} target="_blank" rel="noopener">Full CV (PDF) <Icon name="external" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- OPEN SOURCE -->
  <section id="software" class="section">
    <div class="wrap wrap-wide">
      <h2>Open source</h2>
      <p class="section-lead">Research tools I've built and released.</p>
      <div class="cards">
        {
          software.map((s) => (
            <a class="card card-link" href={s.href} target="_blank" rel="noopener">
              <h3>{s.name}<Icon name="external" size={14} /></h3>
              <p>{s.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WRITING -->
  <section id="writing" class="section">
    <div class="wrap wrap-wide">
      <h2>Writing</h2>
      <p class="section-lead">Research notes and the occasional essay. <a href="/blog">All posts →</a></p>
      <ul class="post-list">
        {
          posts.map((p) => (
            <li>
              <a class="post-link" href={`/blog/${p.id}`}>
                <span class="post-title">{p.data.title}</span>
                <span class="post-date">{fmt(p.data.date)}</span>
              </a>
              {p.data.description && <p class="post-desc muted">{p.data.description}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- OUTSIDE WORK -->
  <section id="outside" class="section tint">
    <div class="wrap wrap-wide">
      <h2>Outside work</h2>
      <p class="section-lead">
        when i'm not working i'm probably thinking about how i can improve my
        strength &amp; form in pull-ups and dreaming about muscle ups 🏋️, or learning
        about the Xs and Os of basketball. i occasionally pick up a book (mainly
        it's on my kindle :P) too, trying to learn more about indian history, world
        history — but won't shy away from a good fiction (sci-fi preferred) or some
        new topic that looks interesting to me.
      </p>

      <h3 class="subhead">Repeat reads</h3>
      <p class="section-lead muted" style="margin-bottom: 1rem;">Blogs &amp; articles i like to revisit from time to time.</p>
      <ul class="reads">
        {
          repeatReads.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener">{r.title}<Icon name="external" size={13} /></a>
              <span class="muted"> — {r.author}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 3.4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 2.6rem;
    align-items: start;
  }
  .hero h1 {
    font-size: 2.4rem;
    margin: 0 0 1rem;
  }
  .lead {
    font-size: 1.12rem;
    margin: 0 0 1rem;
  }
  .sub {
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
  }
  .btn-accent {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn-accent:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff;
  }
  :global(:root[data-theme='dark']) .btn-accent {
    color: #10131c;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .btn-accent {
      color: #10131c;
    }
  }
  .hero-socials {
    display: flex;
    gap: 1rem;
  }
  .hero-socials a {
    color: var(--muted);
    display: inline-flex;
  }
  .hero-socials a:hover {
    color: var(--accent);
  }
  .hero-photo img {
    border-radius: 14px;
    box-shadow: var(--shadow);
    width: 220px;
    height: 220px;
    object-fit: cover;
    border: 3px solid var(--surface);
    outline: 1px solid var(--border);
  }
  .section-lead {
    margin: -0.6rem 0 1.8rem;
    color: var(--text);
  }
  .subhead {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-2);
    margin: 2.2rem 0 1rem;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .card {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 12px;
    padding: 1.2rem 1.3rem;
    border-top: 3px solid var(--accent);
  }
  .card-b {
    border-top-color: var(--accent-2);
  }
  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.02rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }
  .card-link {
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card-link:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--accent-2);
  }
  .card-link:hover h3 {
    color: var(--accent-2);
  }
  .reads {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .reads a {
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    color: var(--text);
  }
  .post-link:hover {
    text-decoration: none;
  }
  .post-link:hover .post-title {
    color: var(--accent);
  }
  .post-title {
    font-weight: 600;
  }
  .post-date {
    color: var(--faint);
    font-size: 0.85rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .post-desc {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .timeline.compact {
    gap: 0.55rem;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
  }
  .tl-body {
    border-left: 2px solid var(--accent-2-soft);
    padding-left: 1rem;
  }
  .tl-period {
    font-size: 0.85rem;
    padding-top: 0.1rem;
    font-variant-numeric: tabular-nums;
  }
  .tl-detail {
    font-size: 0.88rem;
  }
  @media (max-width: 640px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      order: -1;
    }
    .hero-photo img {
      width: 120px;
      height: 120px;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .tl-body {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
